# Copy to .env.local and fill in for local dev / deployment.

# Production site URL — used for canonical/hreflang tags, sitemap.xml,
# robots.txt, Open Graph URLs, and the GitHub Pages CNAME file. This is
# also the code's built-in default (src/lib/seo.ts), so setting it here
# is mainly for overriding it locally (e.g. a staging URL).
NEXT_PUBLIC_SITE_URL=https://leonroofingandrestoration.com

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty to disable analytics entirely — no script loads, no
# tracking code runs, until this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Web3Forms access key — get one free at https://web3forms.com (just
# enter the destination email, no account needed, key arrives by email
# in seconds). Powers the contact form's actual email delivery, since
# this site is a static export with no server of its own to receive
# form submissions. Leave empty and the form falls back to a local-only
# "success" demo state — nothing is sent anywhere until this is set.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
