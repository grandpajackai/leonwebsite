# Copy to .env.local and fill in for local dev / deployment.

# Production site URL — used for canonical/hreflang tags, sitemap.xml,
# robots.txt, and Open Graph URLs. Update once the real domain is live.
NEXT_PUBLIC_SITE_URL=https://www.leonroofingrestoration.com

# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty to disable analytics entirely — no script loads, no
# tracking code runs, until this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
